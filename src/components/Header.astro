---
const navItems = [
  { label: "Inicio", href: "/" },
  {
    label: "Iglesia",
    href: "/iglesia",
    submenu: [
      { label: "Nuevo en la Iglesia", href: "/iglesia/nuevo" },
      { label: "Células", href: "/iglesia/celulas" },
      { label: "Discipulado", href: "/iglesia/discipulado" },
      { label: "Alabanza PDC", href: "/iglesia/alabanza" },
    ],
  },
  { label: "Horarios", href: "#horarios" },
  { label: "Ubicación", href: "#ubicacion" },
  { label: "Quiénes Somos", href: "#quienes-somos" },
  { label: "Sermones", href: "/sermones" },
  { label: "Contacto", href: "/contacto" },
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-pdc-black/90 backdrop-blur-md border-b border-white/10">
  <nav class="max-w-7xl mx-auto px-6 flex items-center justify-between h-20">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/images/logo-white.png" alt="Puerta del Cielo" class="h-12 w-auto" />
      <span class="font-display text-lg tracking-wide leading-none hidden sm:block">
        PUERTA<br /><span class="text-pdc-cyan">DEL CIELO</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-8 font-body font-semibold text-sm uppercase tracking-wide">
      {navItems.map((item) => (
        <li class="relative group">
          <a
            href={item.href}
            class="hover:text-pdc-cyan transition-colors duration-200 flex items-center gap-1 py-8"
          >
            {item.label}
            {item.submenu && (
              <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>

          {item.submenu && (
            <ul class="absolute top-full left-0 min-w-[220px] bg-pdc-dark border border-white/10 rounded-lg overflow-hidden opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-xl shadow-black/50">
              {item.submenu.map((sub) => (
                <li>
                  <a
                    href={sub.href}
                    class="block px-5 py-3 text-xs hover:bg-white/5 hover:text-pdc-magenta transition-colors duration-150 normal-case font-medium"
                  >
                    {sub.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile menu button -->
    <button id="menu-btn" class="lg:hidden text-white" aria-label="Abrir menú">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/10 bg-pdc-black px-6 py-4">
    <ul class="flex flex-col gap-1 font-body font-semibold text-sm uppercase tracking-wide">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="block py-3 hover:text-pdc-cyan transition-colors">
            {item.label}
          </a>
          {item.submenu && (
            <ul class="pl-4 flex flex-col gap-1 pb-2">
              {item.submenu.map((sub) => (
                <li>
                  <a href={sub.href} class="block py-2 text-xs text-white/70 hover:text-pdc-magenta normal-case">
                    {sub.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
    });
  });
</script>