---
import '../styles/global.css'
import Footer from '../components/Footer.astro'

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = "Iglesia Cristiana en Jiutepec | Puerta del Cielo",
	description = "Iglesia Cristiana Evangélica Puerta del Cielo en Jiutepec, Morelos. Creemos en el poder de Dios para transformar vidas. Reunión general los domingos 11:00am. ¡Te esperamos con los brazos abiertos!",
	image = "/images/logo-color.png",
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://pdcjiutepec.org");
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const siteName = "Iglesia Puerta del Cielo Jiutepec";

// Palabras clave y variantes para búsqueda local
const keywords = [
	"Iglesia Cristiana en Jiutepec",
	"Iglesia Evangélica en Jiutepec",
	"Iglesia en Jiutepec",
	"Iglesia en Jiutepec Morelos",
	"Iglesia Cristiana Jiutepec Morelos",
	"Congregación cristiana Jiutepec",
	"Iglesia Puerta del Cielo",
	"Puerta del Cielo Jiutepec",
	"Iglesia cerca de mí Jiutepec",
	"Reuniones cristianas Jiutepec",
	"Iglesia evangélica Morelos",
].join(", ");

// Datos estructurados JSON-LD — esquema de Iglesia (clave para Google y buscadores con IA)
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Church",
	"@id": siteUrl.href + "#church",
	name: "Iglesia Cristiana Puerta del Cielo",
	alternateName: ["Puerta del Cielo Jiutepec", "Iglesia Puerta del Cielo"],
	description:
		"Iglesia Cristiana Evangélica en Jiutepec, Morelos. Una comunidad de fe que cree en el poder transformador de Dios y lleva esperanza a la ciudad.",
	url: siteUrl.href,
	logo: new URL("/images/logo-color.png", siteUrl).href,
	image: new URL("/images/logo-color.png", siteUrl).href,
	telephone: "+527772440513",
	address: {
		"@type": "PostalAddress",
		streetAddress: "Chabacano #4, Col. Atenatitlán",
		addressLocality: "Jiutepec",
		addressRegion: "Morelos",
		addressCountry: "MX",
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: 18.916628,
		longitude: -99.1600751,
	},
	hasMap:
		"https://www.google.com/maps/place/Iglesia+Cristiana+Puerta+Del+Cielo/@18.9166331,-99.16265,17z",
	sameAs: [
		"https://www.facebook.com/pdcjiutepec/",
		"https://www.youtube.com/@pdccivac",
	],
	openingHoursSpecification: [
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: "Tuesday",
			opens: "10:30",
			closes: "12:00",
			name: "Oración",
		},
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: "Wednesday",
			opens: "06:30",
			closes: "07:30",
			name: "Oración",
		},
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: "Friday",
			opens: "19:00",
			closes: "20:30",
			name: "Adoración y Oración",
		},
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: "Saturday",
			opens: "16:30",
			closes: "18:00",
			name: "Reunión de Jóvenes",
		},
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: "Sunday",
			opens: "11:00",
			closes: "13:30",
			name: "Reunión General",
		},
	],
	areaServed: {
		"@type": "City",
		name: "Jiutepec",
	},
};
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO principal -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Iglesia Cristiana Puerta del Cielo" />
		<link rel="canonical" href={canonical} />
		{noindex
			? <meta name="robots" content="noindex, nofollow" />
			: <meta name="robots" content="index, follow, max-image-preview:large" />}

		<!-- SEO local / geográfico -->
		<meta name="geo.region" content="MX-MOR" />
		<meta name="geo.placename" content="Jiutepec, Morelos" />
		<meta name="geo.position" content="18.916628;-99.1600751" />
		<meta name="ICBM" content="18.916628, -99.1600751" />

		<!-- Open Graph (Facebook, WhatsApp, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="es_MX" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#0a0a0a" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

		<!-- Datos estructurados (Google + buscadores con IA) -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
