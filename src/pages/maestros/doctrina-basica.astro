---
// Manual de Doctrina Básica — lector solo-lectura para maestros.
// El contenido se genera desde el .docx con "a_web.py" (carpeta _herramientas_manual del curso)
// y queda en src/data/manual-doctrina-basica.json.
import Layout from '../../layouts/Layout.astro';
import datos from '../../data/manual-doctrina-basica.json';

const { portada, secciones } = datos;

// Numeración de los temas (la introducción y la guía no llevan número)
let n = 0;
const items = secciones.map((s: any) => {
	let etiqueta = '';
	if (s.tipo === 'tema' && s.id !== 'introduccion') {
		n += 1;
		etiqueta = `Tema ${n}`;
	} else if (s.id === 'introduccion') {
		etiqueta = 'Para comenzar';
	} else {
		etiqueta = 'Antes de empezar';
	}
	return { ...s, etiqueta };
});
---

<Layout
	title="Manual de Doctrina Básica | Puerta del Cielo"
	description="Manual de Doctrina Básica del Curso de Discipulado de la Iglesia Puerta del Cielo. Material de lectura para maestros."
	noindex={true}
>
	<div id="lector" class="lector" data-tema="claro">
		<div id="progreso" class="progreso" aria-hidden="true"></div>

		<!-- Barra superior -->
		<header class="barra">
			<div class="barra-in">
				<button id="btn-indice" class="btn btn-indice" type="button" aria-label="Abrir índice" aria-controls="indice" aria-expanded="false">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
					<span>Índice</span>
				</button>
				<a href="/" class="marca" aria-label="Ir al inicio del sitio">
					<img src="/images/logo-white.png" alt="" class="logo logo-oscuro" />
					<img src="/images/logo-color.png" alt="" class="logo logo-claro" />
					<span class="marca-txt">Manual de Doctrina Básica</span>
				</a>
				<div class="controles" role="group" aria-label="Opciones de lectura">
					<button id="menos" class="btn btn-a" type="button" aria-label="Reducir tamaño de letra"><span class="a-chica">A</span><span class="signo">−</span></button>
					<span id="porcentaje" class="porcentaje" aria-live="polite">100%</span>
					<button id="mas" class="btn btn-a" type="button" aria-label="Aumentar tamaño de letra"><span class="a-grande">A</span><span class="signo">+</span></button>
					<button id="tema" class="btn btn-tema" type="button" aria-label="Cambiar entre fondo claro y oscuro" title="Fondo claro / oscuro">
						<svg class="i-luna" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
						<svg class="i-sol" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
					</button>
				</div>
			</div>
		</header>

		<div class="marco">
			<div id="velo" class="velo" hidden></div>

			<!-- Índice -->
			<nav id="indice" class="indice" aria-label="Índice del manual">
				<div class="indice-cab">
					<span>Contenido</span>
					<button id="cerrar-indice" class="btn-cerrar" type="button" aria-label="Cerrar índice">✕</button>
				</div>
				<ol class="indice-lista">
					{items.map((s: any) => (
						<li>
							<a href={`#${s.id}`} class="ind-tema" data-sec={s.id}>
								<span class="ind-eti">{s.etiqueta}</span>
								<span class="ind-tit">{s.titulo}</span>
							</a>
							{s.subs.length > 0 && (
								<ul class="ind-subs">
									{s.subs.map((u: any) => (
										<li>
											<a href={`#${u.id}`} class="ind-sub" data-sec={u.id}>{u.titulo}</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))}
				</ol>
			</nav>

			<!-- Contenido -->
			<main id="contenido" class="contenido">
				<section class="portada" aria-labelledby="titulo-manual">
					<p class="portada-iglesia">{portada.iglesia}</p>
					<p class="portada-curso">{portada.curso}</p>
					<h1 id="titulo-manual">{portada.titulo}</h1>
					<blockquote class="portada-verso">
						<p>{portada.versiculo}</p>
						<cite>{portada.cita}</cite>
					</blockquote>
					<p class="portada-ayuda">
						Usa <strong>A−</strong> y <strong>A+</strong> arriba para ajustar el tamaño de la letra, y el
						<strong>Índice</strong> para ir a cualquier tema.
					</p>
				</section>

				{items.map((s: any, i: number) => (
					<section id={s.id} class={`seccion seccion-${s.tipo}`} aria-labelledby={`h-${s.id}`}>
						<header class="seccion-cab">
							<p class="eti">{s.etiqueta}</p>
							<h2 id={`h-${s.id}`}>{s.titulo}</h2>
						</header>
						<div class="texto" set:html={s.html} />
						{items[i + 1] && (
							<a class="siguiente" href={`#${items[i + 1].id}`}>
								<span>Siguiente</span>
								<strong>{items[i + 1].titulo}</strong>
							</a>
						)}
					</section>
				))}

				<p class="pie-lector">Material de uso interno del Curso de Discipulado · Iglesia Puerta del Cielo IEI</p>
			</main>
		</div>

		<button id="arriba" class="arriba" type="button" aria-label="Volver al inicio" hidden>
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
		</button>
	</div>

	<!-- Al imprimir no sale el manual -->
	<div class="aviso-impresion">Este manual es solo para lectura en pantalla.</div>
</Layout>

<script>
	const $ = (id: string) => document.getElementById(id)!;
	const lector = $('lector');

	const guardar = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
	const leer = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };

	// ---- Tamaño de letra ------------------------------------------------------------------
	const MIN = 0.85, MAX = 2.0, PASO = 0.1;
	let escala = parseFloat(leer('pdc-manual-escala') || '1');
	if (!(escala >= MIN && escala <= MAX)) escala = 1;
	function aplicarEscala() {
		escala = Math.round(Math.min(MAX, Math.max(MIN, escala)) * 100) / 100;
		lector.style.setProperty('--escala', String(escala));
		$('porcentaje').textContent = Math.round(escala * 100) + '%';
		($('menos') as HTMLButtonElement).disabled = escala <= MIN + 0.001;
		($('mas') as HTMLButtonElement).disabled = escala >= MAX - 0.001;
		guardar('pdc-manual-escala', String(escala));
	}
	// Al cambiar la letra el texto se reacomoda: se vuelve a calcular dónde va el lector (alScroll se define más abajo)
	$('menos').addEventListener('click', () => { escala -= PASO; aplicarEscala(); alScroll(); });
	$('mas').addEventListener('click', () => { escala += PASO; aplicarEscala(); alScroll(); });
	aplicarEscala();

	// ---- Fondo claro / oscuro ---------------------------------------------------------------
	let tema = leer('pdc-manual-tema');
	if (tema !== 'claro' && tema !== 'oscuro') {
		tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro';
	}
	function aplicarTema() {
		lector.dataset.tema = tema!;
		guardar('pdc-manual-tema', tema!);
	}
	$('tema').addEventListener('click', () => { tema = tema === 'claro' ? 'oscuro' : 'claro'; aplicarTema(); });
	aplicarTema();

	// ---- Índice (en celular es un panel lateral) ----------------------------------------------
	const indice = $('indice');
	const velo = $('velo');
	const btnIndice = $('btn-indice');
	function abrirIndice(abrir: boolean) {
		indice.classList.toggle('abierto', abrir);
		velo.hidden = !abrir;
		btnIndice.setAttribute('aria-expanded', String(abrir));
		document.body.classList.toggle('sin-scroll', abrir);
	}
	btnIndice.addEventListener('click', () => abrirIndice(!indice.classList.contains('abierto')));
	$('cerrar-indice').addEventListener('click', () => abrirIndice(false));
	velo.addEventListener('click', () => abrirIndice(false));
	indice.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrirIndice(false)));
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') abrirIndice(false); });

	// ---- Resaltar dónde vas ----------------------------------------------------------------
	const enlaces = new Map<string, HTMLAnchorElement>();
	indice.querySelectorAll<HTMLAnchorElement>('a[data-sec]').forEach((a) => enlaces.set(a.dataset.sec!, a));
	const marcables = Array.from(document.querySelectorAll<HTMLElement>('.seccion, .texto h3[id]'));
	function marcarActual() {
		const linea = window.innerHeight * 0.28;
		let actual: HTMLElement | null = null;
		for (const el of marcables) {
			if (el.getBoundingClientRect().top <= linea) actual = el; else break;
		}
		enlaces.forEach((a) => a.classList.remove('activo'));
		if (actual) {
			const a = enlaces.get(actual.id);
			if (a) {
				a.classList.add('activo');
				const padre = a.closest('li')?.parentElement?.closest('li')?.querySelector<HTMLAnchorElement>('.ind-tema');
				padre?.classList.add('activo-padre');
			}
			// el tema al que pertenece
			const sec = actual.closest('.seccion') as HTMLElement | null;
			enlaces.forEach((l, id) => l.classList.toggle('activo-padre', !!sec && id === sec.id));
		}
	}

	// ---- Progreso y botón "arriba" ------------------------------------------------------------
	const barra = $('progreso');
	const arriba = $('arriba');
	let pendiente = false;
	function alScroll() {
		if (pendiente) return;
		pendiente = true;
		requestAnimationFrame(() => {
			pendiente = false;
			const max = document.documentElement.scrollHeight - window.innerHeight;
			barra.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
			arriba.hidden = window.scrollY < 900;
			marcarActual();
		});
	}
	window.addEventListener('scroll', alScroll, { passive: true });
	window.addEventListener('resize', alScroll);
	window.addEventListener('load', alScroll);
	alScroll();
	arriba.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

	// ---- Solo lectura: sin copiar, sin menú de clic derecho, sin imprimir ----------------------
	const bloquear = (e: Event) => e.preventDefault();
	for (const ev of ['contextmenu', 'copy', 'cut', 'dragstart']) {
		document.getElementById('contenido')!.addEventListener(ev, bloquear);
	}
	document.addEventListener('keydown', (e) => {
		if ((e.ctrlKey || e.metaKey) && ['p', 's'].includes(e.key.toLowerCase())) e.preventDefault();
	});
</script>

<style is:global>
	/* ------------------------------------------------------------------ colores del lector */
	.lector {
		--escala: 1;
		--fondo: #f6f4ee;
		--panel: #ffffff;
		--borde: #e2ddd0;
		--texto: #1f2430;
		--suave: #5d6577;
		--titulo: #1f3b73;
		--acento: #7c3aed;
		--acento2: #0e7490;
		--tinte: #eef2fa;
		--resp-fondo: #f1f3f7;
		--resp-borde: #8a94ab;
		--barra: rgba(255, 255, 255, 0.92);
		--verso: #f3eefc;
		min-height: 100vh;
		background: var(--fondo);
		color: var(--texto);
		font-family: 'Inter', system-ui, sans-serif;
	}
	.lector[data-tema='oscuro'] {
		--fondo: #0a0a0f;
		--panel: #13131a;
		--borde: rgba(255, 255, 255, 0.12);
		--texto: #e6e6ee;
		--suave: #a3a8b8;
		--titulo: #8bd8f0;
		--acento: #e879f9;
		--acento2: #22d3ee;
		--tinte: #16202e;
		--resp-fondo: #181b24;
		--resp-borde: #6b7390;
		--barra: rgba(10, 10, 15, 0.92);
		--verso: #1b1526;
	}

	/* ------------------------------------------------------------------ barra y controles */
	.progreso {
		position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60;
		background: linear-gradient(90deg, #22d3ee, #a855f7, #e879f9);
		transform-origin: left; transform: scaleX(0);
	}
	.barra {
		position: sticky; top: 0; z-index: 50;
		background: var(--barra); backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--borde);
	}
	.barra-in {
		max-width: 80rem; margin: 0 auto; padding: 0 1rem; height: 3.75rem;
		display: flex; align-items: center; gap: 0.75rem;
	}
	.marca { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--texto); min-width: 0; flex: 1; }
	.logo { height: 2.2rem; width: auto; flex: none; }
	.logo-claro { display: block; }
	.logo-oscuro { display: none; }
	.lector[data-tema='oscuro'] .logo-claro { display: none; }
	.lector[data-tema='oscuro'] .logo-oscuro { display: block; }
	.marca-txt { font-weight: 700; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.controles { display: flex; align-items: center; gap: 0.35rem; flex: none; }
	.btn {
		display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
		min-width: 2.75rem; height: 2.75rem; padding: 0 0.7rem;
		border-radius: 0.75rem; border: 1px solid var(--borde);
		background: var(--panel); color: var(--texto); cursor: pointer;
		font: 600 0.9rem 'Inter', sans-serif;
	}
	.btn:hover:not(:disabled) { border-color: var(--acento); color: var(--acento); }
	.btn:disabled { opacity: 0.35; cursor: default; }
	.btn:focus-visible, .btn-cerrar:focus-visible, .arriba:focus-visible, .lector a:focus-visible {
		outline: 3px solid var(--acento2); outline-offset: 2px;
	}
	.btn-a { gap: 0.1rem; }
	.btn-a .a-chica { font-size: 0.85rem; font-weight: 700; }
	.btn-a .a-grande { font-size: 1.25rem; font-weight: 700; }
	.btn-a .signo { font-size: 0.9rem; opacity: 0.8; }
	.porcentaje { min-width: 2.9rem; text-align: center; font-size: 0.8rem; color: var(--suave); font-variant-numeric: tabular-nums; }
	.btn-tema .i-sol { display: none; }
	.lector[data-tema='oscuro'] .btn-tema .i-luna { display: none; }
	.lector[data-tema='oscuro'] .btn-tema .i-sol { display: block; }

	/* ------------------------------------------------------------------ marco e índice */
	.marco { max-width: 80rem; margin: 0 auto; display: grid; grid-template-columns: 18.5rem minmax(0, 1fr); gap: 2.5rem; padding: 0 1rem; }
	.indice {
		position: sticky; top: 3.75rem; align-self: start; max-height: calc(100vh - 3.75rem);
		overflow-y: auto; padding: 1.5rem 0.25rem 2rem 0; font-size: 0.9rem;
	}
	.indice-cab { display: none; }
	.indice-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
	.ind-tema {
		display: flex; flex-direction: column; gap: 0.05rem; padding: 0.55rem 0.8rem;
		border-radius: 0.7rem; text-decoration: none; color: var(--texto);
		border-left: 3px solid transparent;
	}
	.ind-eti { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--suave); font-weight: 700; }
	.ind-tit { font-weight: 700; line-height: 1.25; }
	.ind-tema:hover { background: var(--tinte); }
	.ind-tema.activo-padre { border-left-color: var(--acento); background: var(--tinte); }
	.ind-subs { list-style: none; margin: 0.15rem 0 0.4rem 1.2rem; padding: 0 0 0 0.75rem; border-left: 1px solid var(--borde); }
	.ind-sub { display: block; padding: 0.3rem 0.5rem; border-radius: 0.5rem; text-decoration: none; color: var(--suave); line-height: 1.3; }
	.ind-sub:hover { color: var(--texto); background: var(--tinte); }
	.ind-sub.activo { color: var(--acento); font-weight: 700; }
	.ind-tema.activo { color: var(--acento); }
	.btn-indice { display: none; }
	.velo { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 70; }

	/* ------------------------------------------------------------------ contenido */
	.contenido {
		min-width: 0; padding: 2rem 0 5rem;
		font-size: calc(1.0625rem * var(--escala)); line-height: 1.75;
		-webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
	}
	.contenido > * { max-width: 46em; margin-left: auto; margin-right: auto; }

	.portada {
		text-align: center; padding: 3rem 1.5rem; margin-bottom: 3rem; border-radius: 1.25rem;
		background: linear-gradient(160deg, #10163a 0%, #1f3b73 55%, #4c1d95 100%); color: #fff;
	}
	.portada-iglesia { margin: 0; font-weight: 800; letter-spacing: 0.14em; font-size: 0.85em; color: #7dd3fc; }
	.portada-curso { margin: 0.2rem 0 1.5rem; color: rgba(255, 255, 255, 0.75); font-size: 0.95em; }
	.portada h1 { font-family: 'Anton', 'Inter', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 2.6em; line-height: 1.1; letter-spacing: 0.02em; margin: 0 0 1.6rem; }
	.portada-verso { margin: 0 auto 1.4rem; max-width: 34em; font-style: italic; line-height: 1.65; font-size: 0.95em; color: rgba(255, 255, 255, 0.92); }
	.portada-verso p { margin: 0 0 0.5rem; }
	.portada-verso cite { font-style: normal; font-weight: 700; font-size: 0.85em; color: #f0abfc; }
	.portada-ayuda { margin: 0 auto; max-width: 30em; font-size: 0.82em; color: rgba(255, 255, 255, 0.7); line-height: 1.5; }

	.seccion { scroll-margin-top: 4.75rem; margin-bottom: 4.5rem; }
	.seccion-cab { text-align: center; margin-bottom: 1.8rem; padding-bottom: 1.4rem; border-bottom: 2px solid var(--borde); }
	.eti { margin: 0; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.72em; font-weight: 800; color: var(--acento); }
	.seccion h2 { font-family: 'Anton', 'Inter', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 2.1em; line-height: 1.15; letter-spacing: 0.02em; color: var(--titulo); margin: 0.3rem 0 0; }

	.texto h3 {
		scroll-margin-top: 4.75rem; margin: 2.4em 0 0.7em; font-size: 1.32em; line-height: 1.3; color: var(--titulo);
		padding-bottom: 0.35em; border-bottom: 1px solid var(--borde); font-weight: 800;
	}
	.texto h3 .romano {
		display: inline-block; min-width: 2.1em; margin-right: 0.35em; padding: 0.05em 0.45em; text-align: center;
		border-radius: 0.5em; background: var(--titulo); color: var(--fondo); font-size: 0.85em;
	}
	.texto h4 { margin: 1.8em 0 0.5em; font-size: 1.1em; color: var(--titulo); font-weight: 800; }
	.texto p { margin: 0 0 1em; }
	.texto p.cuerpo, .texto p.sub, .texto p.sub2 { text-align: left; hyphens: auto; }
	.texto p.sub { margin-left: 1.2em; }
	.texto p.sub2 { margin-left: 2.4em; }
	.texto strong { font-weight: 700; }

	.texto p.item {
		display: grid; grid-template-columns: 2em 1fr; margin: 0 0 0.75em 0.6em; gap: 0.1em;
	}
	.texto p.item.sub { margin-left: 2em; }
	.texto p.item .rot { font-weight: 800; color: var(--acento); text-align: right; padding-right: 0.45em; }

	.texto ul.vinetas { list-style: none; margin: 0 0 1.2em; padding: 0; }
	.texto ul.vinetas li { position: relative; padding-left: 1.7em; margin-bottom: 0.7em; }
	.texto ul.vinetas li::before { content: '◆'; position: absolute; left: 0.25em; top: 0.1em; font-size: 0.8em; color: var(--acento2); }

	.texto blockquote { margin: 1.4em 0; }
	.texto blockquote.verso {
		padding: 0.9em 1.2em; border-left: 4px solid var(--acento); background: var(--verso);
		border-radius: 0 0.8em 0.8em 0; font-style: italic; line-height: 1.7;
	}
	.texto blockquote.epigrafe {
		text-align: center; font-style: italic; margin: 0 auto 2em; max-width: 32em; padding: 0 0.5em; color: var(--suave); line-height: 1.65;
	}
	.texto blockquote.epigrafe cite { display: block; margin-top: 0.4em; font-style: normal; font-weight: 800; font-size: 0.85em; color: var(--acento); }

	.texto p.pregunta {
		display: grid; grid-template-columns: 2.1em 1fr; gap: 0.5em; align-items: start;
		margin: 1.7em 0 0.5em; padding: 0.8em 1em; border-radius: 0.9em;
		background: var(--tinte); border: 1px solid var(--borde); font-weight: 700; color: var(--texto);
	}
	.texto p.pregunta .num {
		display: inline-flex; align-items: center; justify-content: center; width: 1.9em; height: 1.9em;
		border-radius: 50%; background: var(--acento); color: #fff; font-size: 0.85em; font-weight: 800;
	}
	.texto p.pregunta.sin-num { grid-template-columns: 1fr; }
	.texto p.pregunta.sin-num .num { display: none; }
	.texto .respuesta {
		margin: 0 0 1.4em 1.2em; padding: 0.75em 1em; border-left: 4px solid var(--resp-borde);
		background: var(--resp-fondo); border-radius: 0 0.7em 0.7em 0; color: var(--suave);
