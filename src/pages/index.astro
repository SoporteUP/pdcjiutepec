---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const horarios = [
  { dia: "Martes", actividad: "Oración", hora: "10:30am – 12:00pm" },
  { dia: "Miércoles", actividad: "Oración", hora: "6:30am – 7:30am" },
  { dia: "Viernes", actividad: "Adoración y Oración", hora: "7:00pm – 8:30pm" },
  { dia: "Sábados", actividad: "Reunión de Jóvenes", hora: "4:30pm – 6:00pm" },
  { dia: "Domingos", actividad: "Reunión General", hora: "11:00am – 1:30pm" },
];
---

<Layout>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative min-h-screen flex items-center overflow-hidden pt-20">
      <!-- Anillo neón decorativo de fondo -->
      <div class="absolute right-[-10%] top-1/2 -translate-y-1/2 w-[700px] h-[700px] opacity-30 pointer-events-none">
        <div class="absolute inset-0 rounded-full border-4 border-pdc-cyan blur-sm animate-spin-slow"></div>
        <div class="absolute inset-8 rounded-full border-4 border-pdc-magenta blur-sm animate-spin-slower"></div>
        <div class="absolute inset-16 rounded-full border-4 border-pdc-purple blur-sm animate-spin-slow"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-6 w-full grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="font-body font-bold text-pdc-cyan text-sm uppercase tracking-[0.2em] mb-4">
            Morelos · México
          </p>
          <h1 class="font-display text-6xl sm:text-7xl lg:text-8xl leading-[0.9] uppercase">
            Puerta
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-pdc-cyan via-pdc-magenta to-pdc-purple">
              del Cielo
            </span>
          </h1>
          <p class="font-display text-2xl sm:text-3xl text-white/80 mt-6 uppercase tracking-wide">
            Transformando la Ciudad
          </p>
          <p class="font-body text-white/60 mt-6 max-w-md leading-relaxed">
            Una iglesia que cree en el poder de Dios para cambiar vidas.
            Te esperamos con los brazos abiertos.
          </p>

          <div class="flex flex-wrap gap-4 mt-10">
            <a
              href="/iglesia/nuevo"
              class="bg-gradient-to-r from-pdc-magenta to-pdc-purple font-body font-bold uppercase tracking-wide text-sm px-8 py-4 rounded-full hover:scale-105 transition-transform duration-200"
            >
              Soy Nuevo Aquí
            </a>
            <a
              href="#horarios"
              class="border-2 border-pdc-cyan text-pdc-cyan font-body font-bold uppercase tracking-wide text-sm px-8 py-4 rounded-full hover:bg-pdc-cyan hover:text-pdc-black transition-colors duration-200"
            >
              Ver Horarios
            </a>
          </div>
        </div>

        <div class="relative hidden lg:flex justify-center items-center">
          <img
            src="/images/logo-white.png"
            alt="Logo Puerta del Cielo"
            class="w-72 h-auto relative z-10 drop-shadow-[0_0_40px_rgba(34,211,238,0.4)]"
          />
        </div>
      </div>
    </section>

    <!-- HORARIOS -->
    <section id="horarios" class="py-24 px-6 bg-pdc-dark border-y border-white/10 scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <p class="font-body font-bold text-pdc-teal text-sm uppercase tracking-[0.2em] mb-3">
          Esta Semana
        </p>
        <h2 class="font-display text-5xl sm:text-6xl uppercase mb-14">
          Horarios
        </h2>

        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {horarios.map((h) => (
            <div class="bg-pdc-black border border-white/10 rounded-2xl p-6 hover:border-pdc-cyan/50 transition-colors duration-300">
              <p class="font-display text-xl uppercase text-pdc-cyan mb-2">{h.dia}</p>
              <p class="font-body font-semibold text-white mb-1">{h.actividad}</p>
              <p class="font-body text-sm text-white/50">{h.hora}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- QUIENES SOMOS -->
    <section id="quienes-somos" class="py-24 px-6 scroll-mt-20">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="font-body font-bold text-pdc-magenta text-sm uppercase tracking-[0.2em] mb-3">
            Quiénes Somos
          </p>
          <h2 class="font-display text-5xl uppercase leading-tight mb-6">
            Amar. Servir.<br />Transformar.
          </h2>
          <p class="font-body text-white/60 leading-relaxed mb-8">
            Somos una comunidad que cree en el poder transformador de Dios.
            Llevamos esperanza a cada rincón de nuestra ciudad, construyendo
            una familia genuina basada en la fe.
          </p>
          <a
            href="#quienes-somos"
            class="inline-block font-body font-bold text-sm uppercase tracking-wide text-pdc-cyan border-b-2 border-pdc-cyan pb-1 hover:text-white hover:border-white transition-colors"
          >
            Conoce Más →
          </a>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-pdc-dark border border-pdc-cyan/30 rounded-2xl p-6 aspect-square flex flex-col justify-center">
            <p class="font-display text-3xl text-pdc-cyan mb-1">Fe</p>
            <p class="font-body text-xs text-white/50">El poder de Dios transforma</p>
          </div>
          <div class="bg-pdc-dark border border-pdc-magenta/30 rounded-2xl p-6 aspect-square flex flex-col justify-center">
            <p class="font-display text-3xl text-pdc-magenta mb-1">Familia</p>
            <p class="font-body text-xs text-white/50">Una comunidad que acompaña</p>
          </div>
          <div class="bg-pdc-dark border border-pdc-purple/30 rounded-2xl p-6 aspect-square flex flex-col justify-center">
            <p class="font-display text-3xl text-pdc-purple mb-1">Misión</p>
            <p class="font-body text-xs text-white/50">Esperanza a cada frontera</p>
          </div>
          <div class="bg-pdc-dark border border-pdc-teal/30 rounded-2xl p-6 aspect-square flex flex-col justify-center">
            <p class="font-display text-3xl text-pdc-teal mb-1">Impacto</p>
            <p class="font-body text-xs text-white/50">Transformamos la ciudad</p>
          </div>
        </div>
      </div>
    </section>

    <!-- UBICACIÓN -->
    <section id="ubicacion" class="py-24 px-6 bg-pdc-dark border-t border-white/10 scroll-mt-20">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="font-display text-4xl sm:text-5xl uppercase mb-6">
          Te esperamos este <span class="text-pdc-cyan">domingo</span>
        </h2>
        <p class="font-body text-white/60 mb-10">
          Domingos 11:00am – 1:30pm · Reunión General
        </p>

        <div class="rounded-2xl overflow-hidden border border-white/10 mb-8">
          <iframe
            src="https://www.google.com/maps?q=18.916628,-99.1600751&z=18&output=embed"
            width="100%"
            height="400"
            style="border:0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de ubicación de Iglesia Puerta del Cielo"
          ></iframe>
        </div>

        <a
          href="https://www.google.com/maps/place/Iglesia+Cristiana+Puerta+Del+Cielo/@18.9166331,-99.16265,17z/data=!3m1!4b1!4m6!3m5!1s0x85ce7509a82f4589:0x6e29968669da7dda!8m2!3d18.916628!4d-99.1600751!16s%2Fg%2F11c208tn0t"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-r from-pdc-cyan via-pdc-magenta to-pdc-purple font-body font-bold uppercase tracking-wide text-sm px-10 py-4 rounded-full hover:scale-105 transition-transform duration-200"
        >
          Cómo Llegar
        </a>
      </div>
    </section>
  </main>
</Layout>