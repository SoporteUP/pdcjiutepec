---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ReproductorAudio from '../components/ReproductorAudio.astro';
---

<Layout
  title="Sermones y Predicaciones en Audio | Iglesia Puerta del Cielo Jiutepec"
  description="Escucha las predicaciones y mensajes de la Iglesia Cristiana Puerta del Cielo en Jiutepec, Morelos. Audios de nuestras reuniones para escuchar cuando quieras."
>
  <Header />

  <main class="pt-32 pb-24 px-6 max-w-5xl mx-auto">
    <h1 class="font-display text-5xl sm:text-6xl uppercase text-center mb-4">Sermones</h1>
    <p class="font-body text-white/60 text-center max-w-xl mx-auto mb-12">
      Escucha las predicaciones de Puerta del Cielo cuando quieras, donde quieras.
    </p>

    <ReproductorAudio categoria="predicacion" vacio="Próximamente subiremos las predicaciones." />

    <p class="mt-14 text-center font-body text-sm text-white/50">
      ¿Buscas los tiempos de adoración?
      <a href="/alabanza" class="text-pdc-cyan hover:text-pdc-magenta transition-colors font-semibold">Escucha la alabanza</a>.
    </p>
    <p class="mt-3 text-center font-body text-sm text-white/50">
      ¿Prefieres ver los mensajes en video?
      <a
        href="https://www.youtube.com/@pdccivac"
        target="_blank"
        rel="noopener noreferrer"
        class="text-pdc-cyan hover:text-pdc-magenta transition-colors font-semibold"
      >Visita nuestro canal de YouTube</a>.
    </p>
  </main>
</Layout>
