---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

interface Recurso {
  titulo: string;
  descripcion: string;
  tipo: "historieta";
  imagenes: string[];
}

interface Seccion {
  id: string;
  titulo: string;
  recursos: Recurso[];
}

const secciones: Seccion[] = [
  {
    id: "nuevos-creyentes",
    titulo: "Recursos para Nuevos Creyentes",
    recursos: [
      {
        titulo: "Nuevo en la Fe: Primera Vez",
        descripcion: "Historieta sobre dar el primer paso en la fe.",
        tipo: "historieta",
        imagenes: [
          "/Libros-manuales/Primera Vez-1.jpg",
          "/Libros-manuales/Primera Vez-2.jpg",
          "/Libros-manuales/Primera Vez-3.jpg",
          "/Libros-manuales/Primera Vez-4.jpg",
          "/Libros-manuales/Primera Vez-5.jpg",
          "/Libros-manuales/Primera Vez-6.jpg",
        ],
      },
      {
        titulo: "Ésta Fue Tu Vida",
        descripcion: "Historieta sobre la vida, el juicio y la decisión de seguir a Cristo.",
        tipo: "historieta",
        imagenes: [
          "/Libros-manuales/esta-fue-tu-vida/portada.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-01.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-02.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-03.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-04.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-05.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-06.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-07.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-08.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-09.jpg",
          "/Libros-manuales/esta-fue-tu-vida/escena-10.jpg",
          "/Libros-manuales/esta-fue-tu-vida/cierre.jpg",
        ],
      },
    ],
  },
  {
    id: "discipulado-crecimiento",
    titulo: "Recursos para Discipulado y Crecimiento",
    recursos: [],
  },
  {
    id: "celulas-grupos-contacto",
    titulo: "Recursos para Células o Grupos de Contacto",
    recursos: [],
  },
];
---

<Layout title="Recursos | Puerta del Cielo">
  <Header />

  <main class="pt-32 pb-24 px-6 max-w-7xl mx-auto">
    <h1 class="font-display text-5xl sm:text-6xl uppercase text-center mb-16">
      Recursos
    </h1>

    {secciones.map((seccion) => (
      <section id={seccion.id} class="mb-16">
        <h2 class="font-display text-2xl sm:text-3xl uppercase text-pdc-cyan mb-6">
          {seccion.titulo}
        </h2>

        {seccion.recursos.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {seccion.recursos.map((recurso) => (
              <div class="bg-pdc-dark border border-white/10 rounded-xl overflow-hidden flex flex-col">
                <img
                  src={recurso.imagenes[0]}
                  alt={recurso.titulo}
                  class="w-full h-56 object-cover object-top"
                  loading="lazy"
                />
                <div class="p-5 flex flex-col flex-1">
                  <h3 class="font-body font-bold text-lg mb-2">{recurso.titulo}</h3>
                  <p class="font-body text-white/60 text-sm mb-4 flex-1">
                    {recurso.descripcion}
                  </p>
                  <button
                    type="button"
                    class="comic-modal-trigger w-full bg-gradient-to-r from-pdc-magenta to-pdc-purple font-body font-bold uppercase tracking-wide text-xs px-5 py-3 rounded-full hover:scale-105 transition-transform duration-200"
                    data-comic-title={recurso.titulo}
                    data-comic-images={JSON.stringify(recurso.imagenes)}
                  >
                    Leer historieta
                  </button>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="font-body text-white/40 text-sm italic">Próximamente más recursos.</p>
        )}
      </section>
    ))}
  </main>

  <!-- Modal lector de historieta -->
  <div
    id="comic-modal"
    class="hidden fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm items-center justify-center p-0 sm:p-4"
  >
    <div class="bg-pdc-dark border-0 sm:border sm:border-white/10 sm:rounded-xl w-full h-full sm:max-w-2xl sm:h-[90vh] flex flex-col overflow-hidden">
      <div class="flex items-center justify-between px-4 sm:px-5 py-3 sm:py-4 border-b border-white/10 shrink-0">
        <h3 id="comic-modal-title" class="font-body font-bold text-sm sm:text-base truncate pr-4">
          Historieta
        </h3>
        <button
          id="comic-modal-close"
          type="button"
          aria-label="Cerrar"
          class="text-white/70 hover:text-pdc-magenta transition-colors shrink-0"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div id="comic-modal-viewer" class="flex-1 relative bg-black flex items-center justify-center overflow-hidden touch-pan-y">
        <img id="comic-modal-image" src="" alt="" class="max-w-full max-h-full object-contain select-none" />

        <button
          id="comic-prev"
          type="button"
          aria-label="Página anterior"
          class="absolute left-1 sm:left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/80 text-white rounded-full p-2 transition-colors"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="comic-next"
          type="button"
          aria-label="Página siguiente"
          class="absolute right-1 sm:right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/80 text-white rounded-full p-2 transition-colors"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div class="flex items-center justify-center gap-2 py-3 shrink-0 border-t border-white/10">
        <span id="comic-page-indicator" class="font-body text-xs text-white/60 uppercase tracking-wide"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  let comicImages: string[] = [];
  let comicIndex = 0;

  const modal = document.getElementById("comic-modal");
  const modalTitle = document.getElementById("comic-modal-title");
  const closeBtn = document.getElementById("comic-modal-close");
  const imageEl = document.getElementById("comic-modal-image") as HTMLImageElement | null;
  const prevBtn = document.getElementById("comic-prev");
  const nextBtn = document.getElementById("comic-next");
  const pageIndicator = document.getElementById("comic-page-indicator");
  const viewer = document.getElementById("comic-modal-viewer");

  function showPage(index: number) {
    if (!imageEl || comicImages.length === 0) return;
    comicIndex = Math.max(0, Math.min(index, comicImages.length - 1));
    imageEl.src = comicImages[comicIndex];
    if (pageIndicator) {
      pageIndicator.textContent = `Página ${comicIndex + 1} de ${comicImages.length}`;
    }
    if (prevBtn) (prevBtn as HTMLButtonElement).style.visibility = comicIndex === 0 ? "hidden" : "visible";
    if (nextBtn) (nextBtn as HTMLButtonElement).style.visibility = comicIndex === comicImages.length - 1 ? "hidden" : "visible";
  }

  function openModal(images: string[], title: string) {
    if (!modal) return;
    comicImages = images;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    if (modalTitle) modalTitle.textContent = title;
    showPage(0);
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
    comicImages = [];
  }

  document.querySelectorAll(".comic-modal-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const title = btn.getAttribute("data-comic-title") || "Historieta";
      const imagesRaw = btn.getAttribute("data-comic-images");
      if (!imagesRaw) return;
      const images = JSON.parse(imagesRaw) as string[];
      openModal(images, title);
    });
  });

  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  prevBtn?.addEventListener("click", () => showPage(comicIndex - 1));
  nextBtn?.addEventListener("click", () => showPage(comicIndex + 1));

  document.addEventListener("keydown", (e) => {
    if (modal?.classList.contains("hidden")) return;
    if (e.key === "Escape") closeModal();
    if (e.key === "ArrowLeft") showPage(comicIndex - 1);
    if (e.key === "ArrowRight") showPage(comicIndex + 1);
  });

  // Swipe táctil (móvil)
  let touchStartX = 0;
  viewer?.addEventListener("touchstart", (e) => {
    touchStartX = e.changedTouches[0].clientX;
  });
  viewer?.addEventListener("touchend", (e) => {
    const touchEndX = e.changedTouches[0].clientX;
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) < 40) return;
    if (diff < 0) showPage(comicIndex + 1);
    else showPage(comicIndex - 1);
  });
</script>
