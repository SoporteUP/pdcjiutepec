---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="Soy Nuevo Aquí | Iglesia Puerta del Cielo Jiutepec" description="¿Es tu primera vez? Bienvenido a la Iglesia Cristiana Puerta del Cielo en Jiutepec, Morelos. Conoce nuestras reuniones, células y discipulado. Déjanos tus datos y con gusto te contactamos.">
  <Header />

  <main class="pt-32 pb-24 px-6 max-w-2xl mx-auto">
    <h1 class="font-display text-5xl sm:text-6xl uppercase text-center mb-6">
      Soy Nuevo Aquí
    </h1>
    <p class="font-body text-white/60 text-center mb-12 leading-relaxed">
      Cuéntanos un poco de ti. Nos encantaría conectarte con un grupo de contacto,
      invitarte a discipulado, u orar por ti.
    </p>

    <h2 class="font-body font-bold uppercase text-sm tracking-wide text-white/80 text-center mb-2">
      ¿De qué manera te gustaría integrarte?
    </h2>
    <p class="font-body text-pdc-cyan text-sm font-semibold text-center mb-6">
      Selecciona una o varias opciones (opcional)
    </p>

    <div class="grid sm:grid-cols-3 gap-4 mb-12">
      <label class="relative block cursor-pointer">
        <input type="checkbox" name="interes" value="Reuniones" form="nuevo-form" class="peer sr-only" />
        <span class="pointer-events-none absolute top-4 right-4 z-10 flex items-center gap-1.5 opacity-0 scale-90 peer-checked:opacity-100 peer-checked:scale-100 transition-all duration-200">
          <span class="flex items-center justify-center w-5 h-5 rounded-full bg-pdc-cyan text-black text-xs font-bold">✓</span>
          <span class="font-body text-xs font-bold uppercase tracking-wide text-pdc-cyan">Me interesa</span>
        </span>
        <div class="h-full bg-pdc-dark border border-white/10 rounded-xl p-6 transition-colors peer-checked:border-pdc-cyan peer-checked:bg-pdc-cyan/5">
          <span class="block font-display text-3xl text-pdc-magenta mb-2">01</span>
          <h3 class="font-body font-bold uppercase text-sm tracking-wide mb-2">Reuniones</h3>
          <p class="font-body text-white/60 text-sm leading-relaxed">
            Nuestro servicio de cada domingo, donde toda la iglesia se reúne para adorar,
            escuchar la Palabra y recibir de Dios en comunidad. Ven como estás, sin
            compromiso, es el mejor lugar para empezar.
          </p>
        </div>
      </label>

      <label class="relative block cursor-pointer">
        <input type="checkbox" name="interes" value="Células" form="nuevo-form" class="peer sr-only" />
        <span class="pointer-events-none absolute top-4 right-4 z-10 flex items-center gap-1.5 opacity-0 scale-90 peer-checked:opacity-100 peer-checked:scale-100 transition-all duration-200">
          <span class="flex items-center justify-center w-5 h-5 rounded-full bg-pdc-cyan text-black text-xs font-bold">✓</span>
          <span class="font-body text-xs font-bold uppercase tracking-wide text-pdc-cyan">Me interesa</span>
        </span>
        <div class="h-full bg-pdc-dark border border-white/10 rounded-xl p-6 transition-colors peer-checked:border-pdc-cyan peer-checked:bg-pdc-cyan/5">
          <span class="block font-display text-3xl text-pdc-magenta mb-2">02</span>
          <h3 class="font-body font-bold uppercase text-sm tracking-wide mb-2">Células</h3>
          <p class="font-body text-white/60 text-sm leading-relaxed">
            Grupos pequeños (8 a 15 personas) que se reúnen cada semana en una casa para
            vivir la fe de forma cercana: estudiar la Biblia, orar unos por otros y
            construir amistades reales. La forma más fácil de sentirte en familia.
          </p>
        </div>
      </label>

      <label class="relative block cursor-pointer">
        <input type="checkbox" name="interes" value="Discipulado" form="nuevo-form" class="peer sr-only" />
        <span class="pointer-events-none absolute top-4 right-4 z-10 flex items-center gap-1.5 opacity-0 scale-90 peer-checked:opacity-100 peer-checked:scale-100 transition-all duration-200">
          <span class="flex items-center justify-center w-5 h-5 rounded-full bg-pdc-cyan text-black text-xs font-bold">✓</span>
          <span class="font-body text-xs font-bold uppercase tracking-wide text-pdc-cyan">Me interesa</span>
        </span>
        <div class="h-full bg-pdc-dark border border-white/10 rounded-xl p-6 transition-colors peer-checked:border-pdc-cyan peer-checked:bg-pdc-cyan/5">
          <span class="block font-display text-3xl text-pdc-magenta mb-2">03</span>
          <h3 class="font-body font-bold uppercase text-sm tracking-wide mb-2">Discipulado</h3>
          <p class="font-body text-white/60 text-sm leading-relaxed">
            Un acompañamiento personal para profundizar tu fe: enseñanza bíblica,
            herramientas prácticas y mentoría uno a uno. No solo asistes, te transformas
            y descubres tu lugar en la iglesia.
          </p>
        </div>
      </label>
    </div>

    <form id="nuevo-form" class="bg-pdc-dark border border-white/10 rounded-xl p-6 sm:p-8 flex flex-col gap-5">
      <div>
        <label for="nombre" class="block font-body font-semibold text-sm mb-2">Nombre</label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          required
          maxlength="200"
          class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-3 font-body text-sm focus:outline-none focus:border-pdc-cyan transition-colors"
          placeholder="Tu nombre completo"
        />
      </div>

      <div>
        <label for="celular" class="block font-body font-semibold text-sm mb-2">Número de celular</label>
        <input
          type="tel"
          id="celular"
          name="celular"
          required
          maxlength="30"
          class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-3 font-body text-sm focus:outline-none focus:border-pdc-cyan transition-colors"
          placeholder="777 123 4567"
        />
      </div>

      <div>
        <label for="mensaje" class="block font-body font-semibold text-sm mb-2">
          Mensaje <span class="text-white/40 font-normal">(opcional)</span>
        </label>
        <textarea
          id="mensaje"
          name="mensaje"
          maxlength="2000"
          rows="4"
          class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-3 font-body text-sm focus:outline-none focus:border-pdc-cyan transition-colors resize-none"
          placeholder="¿Cómo podemos ayudarte u orar por ti?"
        ></textarea>
      </div>

      <!-- Honeypot anti-spam, oculto para humanos -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />

      <button
        type="submit"
        class="bg-gradient-to-r from-pdc-magenta to-pdc-purple font-body font-bold uppercase tracking-wide text-sm px-8 py-4 rounded-full hover:scale-105 transition-transform duration-200"
      >
        Enviar
      </button>

      <p id="nuevo-form-status" class="font-body text-sm text-center min-h-[1.25rem]"></p>
    </form>
  </main>
</Layout>

<script>
  const form = document.getElementById('nuevo-form') as HTMLFormElement | null;
  const status = document.getElementById('nuevo-form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const data = new FormData(form);
    const payload = {
      nombre: data.get('nombre'),
      celular: data.get('celular'),
      mensaje: data.get('mensaje'),
      interes: data.getAll('interes').join(', '),
      website: data.get('website'),
    };

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    status.textContent = 'Enviando...';
    status.className = 'font-body text-sm text-center min-h-[1.25rem] text-white/60';

    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (res.ok && result.ok) {
        status.textContent = '¡Gracias! Nos pondremos en contacto contigo pronto.';
        status.className = 'font-body text-sm text-center min-h-[1.25rem] text-pdc-cyan';
        form.reset();
      } else {
        status.textContent = result.error || 'Ocurrió un error. Intenta de nuevo.';
        status.className = 'font-body text-sm text-center min-h-[1.25rem] text-pdc-magenta';
      }
    } catch {
      status.textContent = 'Ocurrió un error de conexión. Intenta de nuevo.';
      status.className = 'font-body text-sm text-center min-h-[1.25rem] text-pdc-magenta';
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
